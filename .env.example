# Supabase Configuration (Client-side - safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Listmonk - Client-side Configuration (NEXT_PUBLIC_ prefix - safe to expose)
# These are list UUIDs used by the frontend
NEXT_PUBLIC_LISTMONK_FOSSFLASH_LIST_UUID=
NEXT_PUBLIC_LISTMONK_DEFAULT_LIST_UUID=

# Listmonk - Server-side ONLY Configuration (NO NEXT_PUBLIC_ prefix - kept secret)
# These credentials are ONLY accessible on the server and hidden from the browser
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_FROM_EMAIL=
LISTMONK_TEMPLATE_ID=1
LISTMONK_LIST_UUID=